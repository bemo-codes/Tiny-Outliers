# CARE/ROUTE Environment Configuration
# Backend configuration (FastAPI + SQLAlchemy + PostgreSQL)
DATABASE_URL=postgresql+asyncpg://careroute_user:careroute_password@localhost:5432/careroute_db
TEST_DATABASE_URL=postgresql+asyncpg://careroute_user:careroute_password@localhost:5432/careroute_test_db
JWT_SECRET_KEY=change_this_to_a_secure_random_256bit_secret_key_in_production
API_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESOURCE_STALE_AFTER_MINUTES=10
ALLOW_DEMO_SEED=true
DEMO_SEED_RANDOM_SEED=42

# Frontend configuration (Vite React)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_HOSPITAL_API_MODE=demo
VITE_RESOURCE_STALE_AFTER_MINUTES=10
